# Copy to .env and fill in your JWT from games.drw.com (browser devtools / login response).
DRW_TOKEN=your_jwt_here

# Game IDs for Call Your Shot 2026 (defaults are the live competition markets).
GAME_ID_BINARY=170
GAME_ID_POINTS=171
GAME_ID_GOALS=172

# Strategy tuning
MIN_EDGE_BINARY=0.75
MIN_EDGE_POINTS=0.50
MIN_EDGE_GOALS=0.40
QUOTE_SIZE=5
MAX_POSITION=90
SIMULATIONS=10000
FAIR_VALUE_REFRESH_SEC=300
